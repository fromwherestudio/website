---
/* =================================================================
   Showreel motion design du hero (boucle 38,4 s, 1080×1080).
   Porté depuis l'export Claude Design « Showreel hero 1080×1080 ».
   - L'artboard 1080×1080 est mis à l'échelle (cover) dans son conteneur ;
     tout le texte vit dans la bande centrale 1080×700 (zone de sécurité).
   - Chaque scène est un <template> remonté à son tour : les animations
     CSS repartent de zéro à chaque passage.
   - Son : synthétisé dans le navigateur (Web Audio), uniquement après
     un clic sur « Activer le son ».
   ================================================================= */

const feedCols = ['#C9A877', '#A6C6E2', '#EFD27E', '#E8A492', '#AEC9A2', '#C7B6E6'];
const feedA = [0, 1, 2, 3, 4].map((i) => ({ bg: feedCols[i], to: [128, 412, 76, 903, 255][i], d: (1.2 + i * 0.9).toFixed(2) }));
const feedB = [0, 1, 2, 3, 4].map((i) => ({ bg: feedCols[(i + 3) % 6], to: [64, 310, 587, 142, 820][i], d: (1.3 + i * 0.9).toFixed(2) }));
const hs = [30, 52, 70, 44, 80, 60, 36, 74, 84, 48, 66, 28, 58, 78, 40, 62, 34, 50];
const bars = hs.map((h, i) => ({ h, dur: (0.32 + ((i * 7) % 5) * 0.07).toFixed(2), d: (0.9 + (i % 6) * 0.05).toFixed(2) }));
const panes = [
  { x: 0, sx: -22, sy: 18, r: -4, cam: 'CAM A', clip: 'EXTRAIT 1', d: 2.05 },
  { x: 116, sx: 0, sy: -10, r: 1, cam: 'CAM B', clip: 'EXTRAIT 2', d: 2.15 },
  { x: 233, sx: 22, sy: 18, r: 4, cam: 'CAM C', clip: 'EXTRAIT 3', d: 2.25 },
];
const pattern = [
  { label: 'INSTA', bg: '#C7B6E6', on: [1, 0, 1, 0, 1, 1, 0] },
  { label: 'TIKTOK', bg: '#E8A492', on: [0, 1, 1, 0, 1, 0, 1] },
  { label: 'YOUTUBE', bg: '#A6C6E2', on: [0, 0, 0, 1, 0, 0, 1] },
  { label: 'LINKEDIN', bg: '#AEC9A2', on: [1, 0, 0, 1, 0, 0, 0] },
];
let k = 0;
const cal = pattern.map((row) => ({
  label: row.label,
  cells: row.on.map((on) => ({ bg: on ? row.bg : 'transparent', d: on ? (1.05 + k++ * 0.07).toFixed(2) : '0' })),
}));
const prints = [
  { x: 0, y: 14, r: -8, fx: 460, fy: -260, d: 0.55, bg: '#EFD27E', glyph: '▶', cap: 'SCÈNE' },
  { x: 172, y: 0, r: 6, fx: 400, fy: 300, d: 0.7, bg: '#E8A492', glyph: '●', cap: 'FOULE' },
  { x: 14, y: 250, r: 5, fx: 500, fy: 120, d: 0.85, bg: '#A6C6E2', glyph: '▶', cap: 'BACKSTAGE' },
  { x: 178, y: 262, r: -6, fx: 380, fy: -320, d: 1.0, bg: '#C7B6E6', glyph: '↗', cap: 'REPLAY' },
];
const avatars = ['#C9A877', '#A6C6E2', '#EFD27E', '#E8A492', '#AEC9A2', '#C7B6E6', '#C9A877', '#A6C6E2']
  .map((bg, i) => ({ bg, d: (2.45 + i * 0.18).toFixed(2) }));
const plusOnes = [{ x: 40, d: 2.7 }, { x: 120, d: 3.1 }, { x: 200, d: 3.5 }, { x: 80, d: 3.9 }];
const days = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
const nodeX = [320, 460, 600, 740, 880];

const folder = 'position: absolute; left: 60px; top: 196px; width: 960px; height: 580px; box-sizing: border-box; border: 3px solid #221F18; border-radius: 6px; box-shadow: 14px 14px 0 #46413a; color: #221F18';
const tab = 'position: absolute; left: 40px; top: -3px; height: 54px; padding: 0 24px; display: flex; align-items: center; background: #F2EBDD; border: 3px solid #221F18; border-radius: 0 0 12px 12px; font-size: 20px';
const kicker = 'margin-top: 34px; display: inline-block; padding: 12px 18px; background: #F2EBDD; border: 3px solid #221F18; box-shadow: 5px 5px 0 rgba(34,31,24,.22)';
const adCard = 'position: absolute; width: 196px; height: 132px; box-sizing: border-box; padding: 14px 16px; border: 3px solid #221F18; border-radius: 6px; box-shadow: 6px 6px 0 rgba(34,31,24,.22); display: flex; flex-direction: column; justify-content: space-between';
const chip = 'position: absolute; padding: 10px 12px; border: 3px solid #221F18; box-shadow: 4px 4px 0 rgba(34,31,24,.22); font-size: 15px; letter-spacing: .06em; background-color: #F2EBDD';
const stat = 'position: relative; width: 290px; height: 250px; box-sizing: border-box; padding: 24px; border: 3px solid #221F18; border-radius: 4px; box-shadow: 10px 10px 0 #46413a; color: #221F18';
const plus = 'position: absolute; padding: 3px 6px; background: #221F18; color: #F2EBDD; font-size: 14px';
---

<div class="sr" data-sr>
  <div class="sr-stage hatchd" data-sr-stage aria-hidden="true">
    <div data-sr-scenes></div>

    <!-- ============ 0 · INTRO ============ -->
    <template data-scene="0">
      <div class="scene out" style="animation-delay: 3.85s">
        <div style="position: absolute; left: 0; top: 206px; width: 1080px; display: flex; justify-content: center; align-items: center; gap: 22px">
          <div class="drop B" style="width: 112px; height: 112px; box-sizing: border-box; background: #EFD27E; border: 3px solid #221F18; border-radius: 16px 16px 4px 4px; box-shadow: 8px 8px 0 #C9A877; display: flex; align-items: center; justify-content: center; font-size: 58px; color: #221F18; letter-spacing: -.04em; animation-delay: .15s">FW</div>
          <div style="display: flex; flex-direction: column; gap: 8px">
            <span class="type" style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 62px; letter-spacing: -.03em; line-height: .9; color: #F2EBDD; animation-delay: .8s; animation-duration: .6s; animation-timing-function: steps(9)">fromwhere</span>
            <span class="type M" style="font-size: 18px; letter-spacing: .42em; color: #C9A877; animation-delay: 1.3s; animation-duration: .35s; animation-timing-function: steps(6)">STUDIO</span>
          </div>
        </div>
        <div class="B" style="position: absolute; left: 0; top: 368px; width: 1080px; text-align: center; font-size: 150px; color: #F2EBDD">
          <span class="ln"><span style="animation-delay: 1.45s">FILMER</span></span>
          <span class="ln"><span style="animation-delay: 1.6s">CE QUI</span></span>
          <span class="ln"><span class="em emy" style="animation-delay: 1.75s">COMPTE.</span></span>
        </div>
        <div style="position: absolute; left: 0; top: 790px; width: 1080px; text-align: center">
          <span class="type M" style="font-size: 22px; color: #C9A877; animation-delay: 2.5s; animation-duration: .9s; animation-timing-function: steps(36)">PRODUCTION AUDIOVISUELLE · BRUXELLES</span>
        </div>
      </div>
    </template>

    <!-- ============ 1 · ACCROCHE ============ -->
    <template data-scene="1">
      <div class="scene out" style="animation-delay: 2.05s">
        <div style="position: absolute; left: 0; top: 268px; width: 1080px; text-align: center">
          <span class="type M" style="font-size: 32px; color: #EFD27E; animation-delay: .1s; animation-duration: .5s; animation-timing-function: steps(15)">CE QUI COMPTE ?</span>
        </div>
        <div class="B" style="position: absolute; left: 0; top: 340px; width: 1080px; text-align: center; font-size: 186px; color: #F2EBDD">
          <span class="ln"><span style="animation-delay: .45s">Votre</span></span>
          <span class="ln"><span class="em emc" style="animation-delay: .6s">histoire.</span></span>
        </div>
      </div>
    </template>

    <!-- ============ 2 · ADS (Kraft) ============ -->
    <template data-scene="2">
      <div class="scene out" style="animation-delay: 5.05s">
        <div class="folderIn" style={`${folder}; background: #C9A877; --r: -0.6deg`}>
          <div class="tabUp M" style={`${tab}; animation-delay: .45s`}>DOSSIER 01 — ADS</div>
          <div style="position: absolute; left: 48px; top: 104px; width: 510px">
            <div class="B" style="font-size: 70px; color: #221F18">
              <span class="ln"><span style="animation-delay: .6s">On la crée.</span></span>
              <span class="ln"><span style="animation-delay: .75s">On la tourne.</span></span>
              <span class="ln"><span style="animation-delay: .9s">On la fait</span></span>
              <span class="ln"><span class="em" style="animation-delay: 1.05s">performer.</span></span>
            </div>
            <div class="pop" style={`${kicker}; --r: -1.5deg; animation-delay: 1.4s`}>
              <span class="type M" style="font-size: 20px; color: #221F18; animation-delay: 1.6s; animation-duration: .8s; animation-timing-function: steps(26)">CRÉA · TOURNAGE · PILOTAGE</span>
            </div>
          </div>
          <div style="position: absolute; left: 572px; top: 66px; width: 350px; height: 460px">
            <div class="float" style="position: absolute; left: 0; top: 0; width: 350px; height: 230px; animation-delay: 2s">
              <div class="toss" style={`${adCard}; left: 0; top: 46px; background: #A6C6E2; --r: -9deg; --fx: 520px; --fy: -120px; animation-delay: .95s`}>
                <span class="M" style="font-size: 13px">ADS ↗</span><span class="B" style="font-size: 44px">Meta</span>
              </div>
              <div class="toss" style={`${adCard}; left: 78px; top: 22px; background: #E8A492; --r: -1deg; --fx: 520px; --fy: 60px; animation-delay: 1.1s`}>
                <span class="M" style="font-size: 13px">ADS ▶</span><span class="B" style="font-size: 44px">YouTube</span>
              </div>
              <div class="toss" style={`${adCard}; left: 154px; top: 58px; background: #C7B6E6; --r: 8deg; --fx: 520px; --fy: 200px; animation-delay: 1.25s`}>
                <span class="M" style="font-size: 13px">ADS ↗</span><span class="B" style="font-size: 44px">TikTok</span>
              </div>
            </div>
            <div class="pop hatch" style="position: absolute; left: 0; top: 256px; width: 350px; height: 196px; box-sizing: border-box; background-color: #F2EBDD; border: 3px solid #221F18; border-radius: 4px; box-shadow: 8px 8px 0 rgba(34,31,24,.22); --r: 1deg; animation-delay: 1.5s">
              <span class="M" style="position: absolute; left: 14px; top: 12px; font-size: 13px">PILOTAGE</span>
              <svg width="344" height="190" viewBox="0 0 344 190" style="position: absolute; left: 0; top: 0">
                <polyline class="draw" pathLength="1000" points="22,168 82,168 82,136 142,136 142,104 202,104 202,72 262,72 262,44 318,44" fill="none" stroke="#221F18" stroke-width="6" stroke-linejoin="miter" style="animation-delay: 1.8s"></polyline>
              </svg>
              <span class="pop B" style="position: absolute; right: 12px; top: 0; font-size: 48px; color: #221F18; animation-delay: 3.2s">↗</span>
            </div>
          </div>
        </div>
      </div>
    </template>

    <!-- ============ 3 · RÉSEAUX (Lila) ============ -->
    <template data-scene="3">
      <div class="scene out" style="animation-delay: 5.05s">
        <div class="folderIn" style={`${folder}; background: #C7B6E6; --r: 0.5deg`}>
          <div class="tabUp M" style={`${tab}; animation-delay: .45s`}>DOSSIER 02 — RÉSEAUX</div>
          <div style="position: absolute; left: 48px; top: 104px; width: 510px">
            <div class="B" style="font-size: 76px; color: #221F18">
              <span class="ln"><span style="animation-delay: .6s">Petits</span></span>
              <span class="ln"><span style="animation-delay: .75s">formats,</span></span>
              <span class="ln"><span class="em" style="animation-delay: .9s">grandes</span></span>
              <span class="ln"><span class="em" style="animation-delay: 1.05s">communautés.</span></span>
            </div>
            <div class="pop" style={`${kicker}; padding: 12px 16px; --r: 1.2deg; animation-delay: 1.4s`}>
              <span class="type M" style="font-size: 17px; letter-spacing: .1em; color: #221F18; animation-delay: 1.6s; animation-duration: 1s; animation-timing-function: steps(40)">FORMATS COURTS · CALENDRIER · COMMUNAUTÉ</span>
            </div>
          </div>
          <div class="pop hatch" style="position: absolute; left: 572px; top: 60px; width: 350px; height: 470px; box-sizing: border-box; overflow: hidden; background-color: #EAE0CD; border: 3px solid #221F18; border-radius: 8px; box-shadow: 8px 8px 0 rgba(34,31,24,.22); --r: 0deg; animation-delay: .7s">
            <div class="feed" style="position: absolute; left: 12px; top: 14px; width: 155px; animation-delay: 1s">
              {feedA.map((f) => (
                <div class="hatch" style={`position: relative; width: 155px; height: 276px; margin-bottom: 18px; box-sizing: border-box; background-color: ${f.bg}; border: 3px solid #221F18; border-radius: 6px`}>
                  <span class="B" style="position: absolute; left: 0; top: 104px; width: 149px; text-align: center; font-size: 46px">▶</span>
                  <span class="M" style="position: absolute; left: 10px; bottom: 10px; padding: 4px 6px; background: #F2EBDD; border: 2px solid #221F18; font-size: 13px; letter-spacing: .06em">♥ <span class="count" style={`--to: ${f.to}; animation-delay: ${f.d}s`}></span>K</span>
                </div>
              ))}
            </div>
            <div class="feed" style="position: absolute; left: 180px; top: -126px; width: 155px; animation-delay: 1.15s">
              {feedB.map((f) => (
                <div class="hatch" style={`position: relative; width: 155px; height: 276px; margin-bottom: 18px; box-sizing: border-box; background-color: ${f.bg}; border: 3px solid #221F18; border-radius: 6px`}>
                  <span class="B" style="position: absolute; left: 0; top: 104px; width: 149px; text-align: center; font-size: 46px">▶</span>
                  <span class="M" style="position: absolute; left: 10px; bottom: 10px; padding: 4px 6px; background: #F2EBDD; border: 2px solid #221F18; font-size: 13px; letter-spacing: .06em">▶ <span class="count" style={`--to: ${f.to}; animation-delay: ${f.d}s`}></span>K</span>
                </div>
              ))}
            </div>
            <div class="thumb" style="position: absolute; left: 150px; top: 330px; width: 46px; height: 46px; box-sizing: border-box; border-radius: 50%; background: #221F18; border: 3px solid #F2EBDD; animation-delay: 1.6s"></div>
          </div>
          <div class="pop" style="position: absolute; left: 596px; top: 432px; width: 304px; box-sizing: border-box; padding: 12px 14px 14px; background: #F2EBDD; border: 3px solid #221F18; border-radius: 4px; box-shadow: 7px 7px 0 rgba(34,31,24,.25); --r: -3deg; animation-delay: 2.2s">
            <div class="M" style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 10px"><span>VOTRE COMMUNAUTÉ</span><span class="B" style="font-size: 22px; letter-spacing: 0; line-height: 14px">↗</span></div>
            <div style="display: flex; align-items: center">
              {avatars.map((a) => (
                <div class="pop" style={`width: 36px; height: 36px; margin-right: -10px; box-sizing: border-box; border-radius: 50%; border: 3px solid #221F18; background: ${a.bg}; animation-delay: ${a.d}s`}></div>
              ))}
              <div class="pop B" style="margin-left: 18px; width: 36px; height: 36px; box-sizing: border-box; border-radius: 50%; border: 3px dashed #221F18; display: flex; align-items: center; justify-content: center; font-size: 24px; letter-spacing: 0; animation-delay: 3.9s">+</div>
            </div>
            {plusOnes.map((q) => (
              <span class="plusOne M" style={`position: absolute; left: ${q.x}px; top: -6px; padding: 3px 6px; background: #221F18; color: #F2EBDD; font-size: 13px; letter-spacing: .04em; animation-delay: ${q.d}s`}>+1</span>
            ))}
          </div>
        </div>
      </div>
    </template>

    <!-- ============ 4 · PODCASTS (Bleu) ============ -->
    <template data-scene="4">
      <div class="scene out" style="animation-delay: 5.05s">
        <div class="folderIn" style={`${folder}; background: #A6C6E2; --r: -0.5deg`}>
          <div class="tabUp M" style={`${tab}; animation-delay: .45s`}>DOSSIER 03 — PODCASTS</div>
          <div class="stamp M" style="position: absolute; left: 448px; top: 14px; padding: 8px 14px; border: 3px dashed #221F18; font-size: 17px; color: #221F18; --r: -3deg; animation-delay: 1.6s">NOTRE SPÉCIALITÉ</div>
          <div style="position: absolute; left: 48px; top: 104px; width: 510px">
            <div class="B" style="font-size: 74px; color: #221F18">
              <span class="ln"><span style="animation-delay: .6s">On installe</span></span>
              <span class="ln"><span style="animation-delay: .75s">un format,</span></span>
              <span class="ln"><span class="em" style="animation-delay: .9s">pas un</span></span>
              <span class="ln"><span class="em" style="animation-delay: 1.05s">épisode.</span></span>
            </div>
            <div class="pop" style={`${kicker}; --r: -1.2deg; animation-delay: 1.4s`}>
              <span class="type M" style="font-size: 20px; color: #221F18; animation-delay: 1.6s; animation-duration: .8s; animation-timing-function: steps(28)">DÉCOR · MULTI-CAM · EXTRAITS</span>
            </div>
          </div>
          <div style="position: absolute; left: 572px; top: 82px; width: 350px; height: 450px">
            <div class="pop" style="position: absolute; left: 0; top: 0; width: 350px; height: 132px; box-sizing: border-box; background: #F2EBDD; border: 3px solid #221F18; border-radius: 4px; box-shadow: 8px 8px 0 rgba(34,31,24,.22); --r: -1deg; animation-delay: .8s">
              <span class="M" style="position: absolute; left: 12px; top: 10px; font-size: 13px"><span style="color: #E8A492">●</span> REC</span>
              <div style="position: absolute; left: 18px; top: 34px; width: 308px; height: 84px; display: flex; align-items: center; gap: 8px">
                {bars.map((b) => (
                  <div class="bar" style={`width: 9px; height: ${b.h}px; background: #221F18; animation-duration: ${b.dur}s; animation-delay: ${b.d}s`}></div>
                ))}
              </div>
            </div>
            <div style="position: absolute; left: 0; top: 176px; width: 350px; height: 197px">
              <div class="pop hatch" style="position: absolute; left: 0; top: 0; width: 350px; height: 197px; box-sizing: border-box; background-color: #EAE0CD; border: 3px solid #221F18; border-radius: 4px; --r: 0deg; animation-delay: 1.1s">
                <div class="fadeOut" style="width: 100%; height: 100%; animation-delay: 3.05s"></div>
              </div>
              <span class="pop B" style="position: absolute; left: 0; top: 64px; width: 350px; text-align: center; font-size: 60px; animation-delay: 1.3s"><span class="fadeOut" style="display: inline-block; animation-delay: 1.85s">▶</span></span>
              <div class="growY" style="position: absolute; left: 115px; top: 0; width: 3px; height: 197px; background: #221F18; animation-delay: 1.9s"><div class="fadeOut" style="width: 100%; height: 100%; animation-delay: 3.05s"></div></div>
              <div class="growY" style="position: absolute; left: 232px; top: 0; width: 3px; height: 197px; background: #221F18; animation-delay: 2s"><div class="fadeOut" style="width: 100%; height: 100%; animation-delay: 3.05s"></div></div>
              {panes.map((p) => (
                <div class="split" style={`position: absolute; left: ${p.x}px; top: 0; width: 117px; height: 197px; box-sizing: border-box; border: 3px solid transparent; border-radius: 4px; background-color: transparent; --sx: ${p.sx}px; --sy: ${p.sy}px; --r: ${p.r}deg; animation-delay: 3.1s`}>
                  <span class="pop M" style={`position: absolute; left: 8px; top: 8px; padding: 3px 5px; background: #221F18; color: #F2EBDD; font-size: 12px; letter-spacing: .08em; animation-delay: ${p.d}s`}><span class="fadeOut" style="display: inline-block; animation-delay: 3.05s">{p.cam}</span></span>
                  <span class="fadeIn B" style="position: absolute; left: 0; top: 68px; width: 111px; text-align: center; font-size: 40px; animation-delay: 3.4s">▶</span>
                  <span class="fadeIn M" style="position: absolute; left: 0; bottom: 10px; width: 111px; text-align: center; font-size: 12px; letter-spacing: .1em; animation-delay: 3.5s">{p.clip}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </template>

    <!-- ============ 5 · STRATÉGIE (Jaune) ============ -->
    <template data-scene="5">
      <div class="scene out" style="animation-delay: 5.05s">
        <div class="folderIn" style={`${folder}; background: #EFD27E; --r: 0.6deg`}>
          <div class="tabUp M" style={`${tab}; animation-delay: .45s`}>DOSSIER 04 — STRATÉGIE</div>
          <div style="position: absolute; left: 48px; top: 120px; width: 510px">
            <div class="B" style="font-size: 92px; color: #221F18">
              <span class="ln"><span style="animation-delay: .6s">Une marque</span></span>
              <span class="ln"><span style="animation-delay: .75s">qu'on</span></span>
              <span class="ln"><span class="em" style="animation-delay: .9s">reconnaît.</span></span>
            </div>
            <div class="pop" style={`${kicker}; margin-top: 40px; padding: 12px 16px; --r: -1.4deg; animation-delay: 1.3s`}>
              <span class="type M" style="font-size: 17px; letter-spacing: .1em; color: #221F18; animation-delay: 1.5s; animation-duration: 1s; animation-timing-function: steps(40)">POSITIONNEMENT · LIGNE ÉDITO · CALENDRIER</span>
            </div>
          </div>
          <div style="position: absolute; left: 572px; top: 64px; width: 350px; height: 470px">
            <div class="pop" style="position: absolute; left: 0; top: 0; width: 350px; box-sizing: border-box; padding: 14px; background: #F2EBDD; border: 3px solid #221F18; border-radius: 4px; box-shadow: 8px 8px 0 rgba(34,31,24,.22); --r: 1deg; animation-delay: .75s">
              <div style="display: flex; gap: 4px; margin-bottom: 6px; padding-left: 62px">
                {days.map((dd) => <span class="M" style="width: 32px; text-align: center; font-size: 14px; letter-spacing: 0">{dd}</span>)}
              </div>
              {cal.map((row) => (
                <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 4px">
                  <span class="M" style="width: 58px; font-size: 11px; letter-spacing: .02em">{row.label}</span>
                  {row.cells.map((c) => (
                    <div style="width: 32px; height: 32px; box-sizing: border-box; border: 2px solid #221F18; border-radius: 3px; overflow: hidden">
                      <div class="pop" style={`width: 100%; height: 100%; background: ${c.bg}; animation-delay: ${c.d}s`}></div>
                    </div>
                  ))}
                </div>
