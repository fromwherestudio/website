<style is:global>
  @property --sr-n { syntax: '<integer>'; initial-value: 0; inherits: false; }

  .sr { position: absolute; inset: 0; overflow: hidden; background: #221F18; }
  .sr-stage {
    position: absolute; left: 50%; top: 50%; width: 1080px; height: 1080px;
    overflow: hidden; background-color: #221F18; color: #F2EBDD;
    font-family: 'Hanken Grotesk', sans-serif;
    transform: translate(-50%, -50%) scale(.6); visibility: hidden;
  }
  .sr-stage svg { max-width: none; }

  .sr .B { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; letter-spacing: -.035em; line-height: .88; }
  .sr .M { font-family: 'Space Mono', monospace; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; }
  .sr .em { font-style: italic; font-weight: 600; position: relative; display: inline-block; padding-right: .08em; }
  .sr .em::after { content: ''; position: absolute; left: 0; right: .12em; bottom: .04em; height: .085em; background: #221F18; transform-origin: left; transform: scaleX(0); animation: sr-swipe 1s cubic-bezier(.6,0,.2,1) forwards; animation-delay: inherit; }
  .sr .emy::after { background: #EFD27E; }
  .sr .emc::after { background: #E8A492; }
  .sr .hatch { background-image: repeating-linear-gradient(45deg, rgba(34,31,24,.07) 0 2px, transparent 2px 13px); }
  .sr .hatchd, .sr-stage.hatchd { background-image: repeating-linear-gradient(45deg, rgba(242,235,221,.05) 0 2px, transparent 2px 16px); }
  .sr .scene { position: absolute; left: 0; top: 0; width: 1080px; height: 1080px; }

  .sr .out { animation: sr-sceneOut .35s cubic-bezier(.6,0,.9,.4) forwards; }
  .sr .folderIn { animation: sr-folderIn .7s cubic-bezier(.18,1.25,.4,1) both; }
  .sr .tabUp { transform-origin: 50% 0; animation: sr-tabUp .45s cubic-bezier(.2,1.4,.4,1) both; }
  .sr .ln { display: block; overflow: hidden; padding: 0 .12em .1em 0; margin-bottom: -.1em; }
  .sr .ln > span { display: inline-block; animation: sr-rise .6s cubic-bezier(.2,1.12,.4,1) both; }
  .sr .type { display: inline-block; animation: sr-type .9s both; white-space: nowrap; }
  .sr .pop { animation: sr-pop .4s cubic-bezier(.2,1.5,.4,1) both; }
  .sr .drop { animation: sr-drop .8s cubic-bezier(.3,0,.3,1) both; }
  .sr .stamp { animation: sr-stamp .55s cubic-bezier(.3,0,.3,1) both; }
  .sr .toss { animation: sr-toss .65s cubic-bezier(.2,.9,.3,1) both; }
  .sr .fadeIn { animation: sr-fadeIn .3s ease-out both; }
  .sr .fadeOut { animation: sr-fadeOut .3s ease-in forwards; }
  .sr .float { animation: sr-float 2.2s ease-in-out infinite alternate; }
  .sr .sway { animation: sr-sway 1.7s ease-in-out infinite alternate; transform-origin: 50% 0; }
  .sr .flipIn { animation: sr-flipIn .5s cubic-bezier(.2,1.3,.4,1) both; animation-delay: .35s; }
  .sr .draw { stroke-dasharray: 1000; stroke-dashoffset: 1000; animation: sr-draw 1.5s cubic-bezier(.5,0,.2,1) forwards; }
  .sr .bar { transform-origin: 50% 50%; animation-name: sr-bar; animation-timing-function: cubic-bezier(.5,0,.5,1.4); animation-iteration-count: infinite; animation-direction: alternate; }
  .sr .growY { transform-origin: 50% 0; animation: sr-growY .45s cubic-bezier(.5,0,.2,1) both; }
  .sr .split { animation: sr-split .6s cubic-bezier(.2,1.3,.4,1) forwards; }
  .sr .feed { animation: sr-feed 4.4s cubic-bezier(.7,0,.2,1.12) forwards; }
  .sr .thumb { animation: sr-thumb 1.23s ease-in-out 3 both; }
  .sr .spin { animation: sr-spin 2.4s cubic-bezier(.6,0,.3,1) infinite; }
  .sr .chip { animation: sr-pop .4s cubic-bezier(.2,1.5,.4,1) both, sr-chipOn 2.4s linear infinite; }
  .sr .count { counter-reset: sr-n var(--sr-n); animation: sr-count 1.6s cubic-bezier(.2,.8,.2,1) both; }
  .sr .count::after { content: counter(sr-n); }
  .sr .plusOne { opacity: 0; animation: sr-plusOne 1.5s cubic-bezier(.2,.8,.3,1) infinite; }
  .sr .plusOnce { opacity: 0; animation: sr-plusOne 1s cubic-bezier(.2,.8,.3,1) both; }
  .sr .odo { animation: sr-odo 1.8s both; }
  .sr .wobble { animation: sr-wobble .5s ease-in-out 3; }
  .sr .load { transform-origin: 0 50%; animation: sr-load 2.2s both; }
  .sr .blink { animation: sr-blink .9s linear infinite; }
  .sr .rocket { animation: sr-rocket .7s ease-in-out infinite alternate; }
  .sr .nudge { display: inline-block; animation: sr-nudge .7s ease-in-out infinite alternate; animation-delay: 4.3s; }
  .sr .chromeOut { animation: sr-fadeOut .35s ease-in forwards; animation-delay: 5.3s; }
  .sr .rewind { animation: sr-rewind .5s cubic-bezier(.6,0,.9,.4) forwards; animation-delay: 5.05s; }

  .sr.isPaused *, .sr.isPaused *::after { animation-play-state: paused !important; }
  .sr.isStatic *, .sr.isStatic *::after { animation: none !important; transition: none !important; }

  @keyframes sr-sceneOut { to { transform: translateX(-112%) rotate(-4deg); } }
  @keyframes sr-folderIn { from { transform: translateX(118%) rotate(7deg); } to { transform: rotate(var(--r, 0deg)); } }
  @keyframes sr-tabUp { from { transform: scaleY(0); opacity: 0; } 35% { opacity: 1; } to { transform: none; opacity: 1; } }
  @keyframes sr-rise { from { transform: translateY(135%); opacity: 0; } 35% { opacity: 1; } to { transform: none; opacity: 1; } }
  /* le masque finit un peu plus large que le mot : la dernière lettre (et les jambages) ne sont jamais rognés */
  @keyframes sr-type { from { clip-path: inset(-.3em 100% -.3em 0); } to { clip-path: inset(-.3em -.5em -.3em 0); } }
  @keyframes sr-pop { 0% { transform: scale(0) rotate(var(--r, 0deg)); } 70% { transform: scale(1.12) rotate(var(--r, 0deg)); } 100% { transform: scale(1) rotate(var(--r, 0deg)); } }
  @keyframes sr-drop { 0% { transform: translateY(-700px) rotate(-20deg); } 58% { transform: translateY(0) rotate(-4deg) scale(1, 1); } 70% { transform: translateY(0) rotate(-4deg) scale(1.14, .84); } 84% { transform: translateY(-16px) rotate(-3deg) scale(.96, 1.05); } 100% { transform: translateY(0) rotate(-3deg); } }
  @keyframes sr-stamp { 0% { opacity: 0; transform: scale(2.6) rotate(-14deg); } 55% { opacity: 1; transform: scale(1) rotate(var(--r, -2deg)); } 68% { opacity: 1; transform: scale(1.1, .86) rotate(var(--r, -2deg)); } 84% { opacity: 1; transform: scale(.97, 1.04) rotate(var(--r, -2deg)); } 100% { opacity: 1; transform: scale(1) rotate(var(--r, -2deg)); } }
  @keyframes sr-toss { from { opacity: 0; transform: translate(var(--fx, 400px), var(--fy, 0px)) rotate(calc(var(--r, 0deg) + 32deg)) scale(1.15); } 75% { opacity: 1; transform: translate(0, 0) rotate(calc(var(--r, 0deg) - 2deg)) scale(.98); } to { opacity: 1; transform: rotate(var(--r, 0deg)); } }
  @keyframes sr-fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes sr-fadeOut { from { opacity: 1; } to { opacity: 0; } }
  @keyframes sr-float { from { transform: translateY(0); } to { transform: translateY(-9px); } }
  @keyframes sr-sway { from { transform: rotate(-2.5deg); } to { transform: rotate(2.5deg); } }
  @keyframes sr-flipIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes sr-swipe { 0%, 40% { transform: scaleX(0); } 100% { transform: scaleX(1); } }
  @keyframes sr-draw { to { stroke-dashoffset: 0; } }
  @keyframes sr-bar { from { transform: scaleY(.2); } to { transform: scaleY(1); } }
  @keyframes sr-growY { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes sr-split { to { transform: translate(var(--sx), var(--sy)) rotate(var(--r)); background-color: #F2EBDD; border-color: #221F18; box-shadow: 6px 6px 0 rgba(34,31,24,.22); } }
  @keyframes sr-feed { 0%, 18% { transform: translateY(0); } 28%, 46% { transform: translateY(-294px); } 56%, 74% { transform: translateY(-588px); } 84%, 100% { transform: translateY(-882px); } }
  @keyframes sr-thumb { 0% { opacity: 0; transform: translateY(0); } 12% { opacity: 1; transform: translateY(0); } 45% { opacity: 1; transform: translateY(-170px); } 60%, 100% { opacity: 0; transform: translateY(-170px); } }
  @keyframes sr-spin { to { transform: rotate(360deg); } }
  @keyframes sr-chipOn { 0%, 22% { background-color: #221F18; color: #F2EBDD; } 26%, 100% { background-color: #F2EBDD; color: #221F18; } }
  @keyframes sr-count { from { --sr-n: 0; } to { --sr-n: var(--to); } }
  @keyframes sr-rewind { to { transform: scaleX(0); } }
  @keyframes sr-nudge { from { transform: translateX(0); } to { transform: translateX(10px); } }
  @keyframes sr-plusOne { 0% { opacity: 0; transform: translateY(0) scale(.6); } 15% { opacity: 1; transform: translateY(-10px) scale(1); } 70% { opacity: 1; } 100% { opacity: 0; transform: translateY(-110px) scale(1); } }
  @keyframes sr-odo { 0%, 10% { transform: translateY(0); animation-timing-function: cubic-bezier(.3,1.6,.5,1); } 22%, 32% { transform: translateY(-88px); animation-timing-function: cubic-bezier(.3,1.6,.5,1); } 44%, 54% { transform: translateY(-176px); animation-timing-function: cubic-bezier(.3,1.6,.5,1); } 66%, 76% { transform: translateY(-264px); animation-timing-function: cubic-bezier(.3,1.6,.5,1); } 88%, 100% { transform: translateY(-352px); } }
  @keyframes sr-wobble { 0%, 100% { transform: none; } 25% { transform: rotate(-10deg) translateY(-8px); } 75% { transform: rotate(7deg) translateY(-3px); } }
  @keyframes sr-load { 0% { transform: scaleX(0); } 15% { transform: scaleX(.2); } 30% { transform: scaleX(.24); } 48% { transform: scaleX(.5); } 62% { transform: scaleX(.55); } 80% { transform: scaleX(.78); } 100% { transform: scaleX(.86); } }
  @keyframes sr-blink { 0%, 55% { opacity: 1; } 56%, 100% { opacity: .2; } }
  @keyframes sr-rocket { from { transform: translate(0, 0); } to { transform: translate(9px, -14px); } }

  /* ===== Contrôles (hors artboard, toujours visibles) ===== */
  .sr-ctrl { position: absolute; right: 12px; bottom: 12px; z-index: 2; display: flex; gap: 8px; }
  .sr-btn {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-mono); font-weight: 700; font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    background: var(--paper); color: var(--ink);
    border: 1.5px solid var(--ink); box-shadow: 3px 3px 0 rgba(0, 0, 0, .4);
    padding: 7px 11px; cursor: pointer; line-height: 1;
  }
  .sr-btn--sound { background: var(--jaune); }
  .sr-btn--sound[aria-pressed='true'] { background: var(--paper); }
  .sr-btn[data-active] { background: var(--jaune); }
  .sr-btn:focus-visible { outline: 2px solid var(--jaune); outline-offset: 2px; }
  .sr-ico { font-size: 12px; }
  @media (max-width: 860px) {
    .sr-txt { display: none; }
    .sr-btn { padding: 7px 9px; }
  }
</style>

<script>
  const STARTS = [0, 4.2, 6.6, 12.0, 17.4, 22.8, 28.2, 32.4];
  const TOTAL = 38.4;
  const BEAT = 0.6; // 100 BPM
  const MUSIC_VOL = 0.55;
  const SFX_VOL = 0.9;
  const INK = '#221F18', PAPER = '#F2EBDD';
  const SVC = ['#C9A877', '#C7B6E6', '#A6C6E2', '#EFD27E', '#AEC9A2'];
  const TAG_X = [180, 180, 320, 460, 600, 740, 880, 540];
  const TAG_BG = [PAPER, PAPER, SVC[0], SVC[1], SVC[2], SVC[3], SVC[4], PAPER];
  const COUNTERS = ['', 'OUVERTURE', 'DOSSIER 01 / 05', 'DOSSIER 02 / 05', 'DOSSIER 03 / 05', 'DOSSIER 04 / 05', 'DOSSIER 05 / 05', '05 / 05 ✓'];
  const ACCENTS = [PAPER, '#E8A492', SVC[0], SVC[1], SVC[2], SVC[3], SVC[4], '#E8A492'];
  const TAG_TXT = [
    '',
    'commence ici.',
    'on la <span class="em">vend.</span>',
    'on la <span class="em">partage.</span>',
    'on l’<span class="em">installe.</span>',
    'on la <span class="em">structure.</span>',
    'on la fait <span class="em">vivre.</span>',
    '<span class="em">bien racontée.</span>',
  ];

  type Ev = [number, string, ...any[]];

  class Showreel {
    root: HTMLElement;
    stage: HTMLElement;
    mount: HTMLElement;
    tpls: HTMLTemplateElement[];
    chrome: HTMLElement;
    accent: HTMLElement;
    counter: HTMLElement;
    thread: HTMLElement;
    threadIn: HTMLElement;
    arrow: HTMLElement;
    nodes: HTMLElement[];
    tag: HTMLElement;
    tagBox: HTMLElement;
    tagTxt: HTMLElement;
    pauseBtn: HTMLButtonElement;
    soundBtn: HTMLButtonElement;
    restartBtn: HTMLButtonElement;

    scene: number | null = null;
    paused = false;
    offscreen = false;
    isStatic = false;
    t0 = performance.now();
    last = performance.now();

    ctx: AudioContext | null = null;
    audioOn = false;
    aStart = 0;
    comp!: DynamicsCompressorNode;
    music!: GainNode;
    sfx!: GainNode;
    noise!: AudioBuffer;
    events: Ev[] = [];
    nextIdx = 0;
    loopN = 0;
    sched: number | undefined;

    constructor(root: HTMLElement) {
      this.root = root;
      const q = <T extends Element>(s: string) => root.querySelector(s) as unknown as T;
      this.stage = q('[data-sr-stage]');
      this.mount = q('[data-sr-scenes]');
      this.tpls = [...root.querySelectorAll<HTMLTemplateElement>('template[data-scene]')]
        .sort((a, b) => Number(a.dataset.scene) - Number(b.dataset.scene));
      this.chrome = q('[data-sr-chrome]');
      this.accent = q('[data-sr-accent]');
      this.counter = q('[data-sr-counter]');
      this.thread = q('[data-sr-thread]');
      this.threadIn = q('[data-sr-thread-in]');
      this.arrow = q('[data-sr-arrow]');
      this.nodes = [...root.querySelectorAll<HTMLElement>('[data-sr-node]')];
      this.tag = q('[data-sr-tag]');
      this.tagBox = q('[data-sr-tagbox]');
      this.tagTxt = q('[data-sr-tagtxt]');
      this.pauseBtn = q('[data-sr-pause]');
      this.soundBtn = q('[data-sr-sound]');
      this.restartBtn = q('[data-sr-restart]');

      // mise à l'échelle « cover » de l'artboard 1080×1080
      const fit = () => {
        const r = root.getBoundingClientRect();
        const s = Math.max(r.width, r.height) / 1080;
        this.stage.style.transform = `translate(-50%, -50%) scale(${s})`;
        this.stage.style.visibility = 'visible';
      };
      new ResizeObserver(fit).observe(root);
      fit();

      // ne tourne que lorsqu'il est visible à l'écran
      new IntersectionObserver(([e]) => { this.offscreen = !e.isIntersecting; }, { threshold: 0.05 }).observe(root);

      this.pauseBtn.addEventListener('click', () => this.onPause());
      this.soundBtn.addEventListener('click', () => this.onSound());
      this.restartBtn.addEventListener('click', () => this.onRestart());

      // mouvement réduit : image fixe de l'intro, lecture sur demande
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.isStatic = true;
        root.classList.add('isStatic');
      }
      this.setScene(0);
      this.syncButtons();
      setInterval(() => this.tick(), 30);
    }

    /* ---------- horloge ---------- */
    loopTime() {
      if (this.audioOn && this.ctx) return this.ctx.currentTime - this.aStart;
      return (performance.now() - this.t0) / 1000;
    }

    tick() {
      const now = performance.now();
      const dt = now - this.last;
      this.last = now;
      const holding = this.paused || this.offscreen || document.hidden || this.isStatic;
      this.root.classList.toggle('isPaused', holding);
      if (this.audioOn && this.ctx) {
        if (holding && this.ctx.state === 'running') this.ctx.suspend();
        if (!holding && this.ctx.state === 'suspended') this.ctx.resume();
      } else if (holding) {
        this.t0 += dt;
        return;
      }
      let t = this.loopTime();
      if (t < 0) { this.setScene(-1); return; }
      t = t % TOTAL;
      let i = 0;
      for (let k = 0; k < STARTS.length; k++) if (t >= STARTS[k]) i = k;
      this.setScene(i);
    }

    /* ---------- scènes + fil rouge ---------- */
    setScene(i: number) {
      if (i === this.scene) return;
      this.scene = i;
      this.mount.replaceChildren();
      if (i >= 0) this.mount.appendChild(this.tpls[i].content.cloneNode(true));

      const s = Math.max(i, 0);
      this.chrome.style.opacity = s >= 1 ? '1' : '0';
      this.chrome.classList.toggle('chromeOut', s === 7);
      this.counter.textContent = COUNTERS[s];
      this.accent.style.background = ACCENTS[s];
      this.thread.classList.toggle('rewind', s === 7);
      this.threadIn.style.transform = `scaleX(${s >= 1 ? 1 : 0})`;
      this.arrow.style.opacity = s >= 1 ? '1' : '0';
      this.nodes.forEach((n, k) => {
        const done = s >= k + 2;
        n.style.background = done ? SVC[k] : INK;
        n.style.color = done ? INK : PAPER;
        n.style.transform = `scale(${s === k + 2 ? 1.3 : 1})`;
      });
      this.tag.style.left = `${TAG_X[s] - 125}px`;
      this.tag.style.transform = `translateY(${s >= 1 ? 0 : -40}px)`;
      this.tagBox.style.background = TAG_BG[s];
      this.tagTxt.innerHTML = s >= 1
        ? `<div class="flipIn B" style="font-size: 30px; line-height: 30px">${TAG_TXT[s]}</div>`
        : '';
    }

    /* ---------- contrôles ---------- */
    leaveStatic() {
      if (!this.isStatic) return;
      this.isStatic = false;
      this.root.classList.remove('isStatic');
      this.t0 = performance.now();
      this.scene = null; // force le remontage de l'intro
    }

    onPause() {
      if (this.isStatic) { this.leaveStatic(); this.paused = false; }
      else this.paused = !this.paused;
      this.syncButtons();
    }

    // Le son ne touche qu'au son : l'animation continue là où elle en est.
    onSound() {
      if (this.audioOn) this.stopAudio();
      else { this.leaveStatic(); this.startAudio(); }
      this.syncButtons();
    }

    onRestart() {
      this.leaveStatic();
      if (this.audioOn && this.ctx) {
        this.newBuses(); // coupe les sons déjà programmés
        this.aStart = this.ctx.currentTime;
        this.nextIdx = 0; this.loopN = 0;
        this.pump();
      } else {
        this.t0 = performance.now();
      }
      this.scene = null; // force le remontage de l'intro
      this.setScene(0);
      this.syncButtons();
    }

    syncButtons() {
      const stopped = this.paused || this.isStatic;
      const pIco = this.pauseBtn.querySelector('[data-ico]')!;
      const pTxt = this.pauseBtn.querySelector('[data-txt]')!;
      pIco.textContent = stopped ? '▶' : '❚❚';
      pTxt.textContent = stopped ? 'Lecture' : 'Pause';
      this.pauseBtn.setAttribute('aria-label', stopped ? 'Lancer l’animation' : 'Mettre l’animation en pause');
      this.pauseBtn.toggleAttribute('data-active', stopped);

      const sIco = this.soundBtn.querySelector('[data-ico]')!;
      const sTxt = this.soundBtn.querySelector('[data-txt]')!;
      sIco.textContent = this.audioOn ? '■' : '♪';
      sTxt.textContent = this.audioOn ? 'Couper le son' : 'Activer le son';
      this.soundBtn.setAttribute('aria-pressed', String(this.audioOn));
      this.soundBtn.setAttribute('aria-label', this.audioOn ? 'Couper le son' : 'Activer le son');
    }

    /* ---------- son (synthétisé, aucun fichier) ---------- */
    startAudio() {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      if (!AC) return;
      // position actuelle de l'animation : la musique démarre de là, sans relancer l'image
      const now = Math.max(0, this.loopTime()) % TOTAL;
      const ctx: AudioContext = new AC();
      this.ctx = ctx;
      this.comp = ctx.createDynamicsCompressor();
      this.comp.threshold.value = -16; this.comp.ratio.value = 3; this.comp.attack.value = 0.005; this.comp.release.value = 0.2;
      this.comp.connect(ctx.destination);
      this.newBuses();
      const len = ctx.sampleRate * 2;
      this.noise = ctx.createBuffer(1, len, ctx.sampleRate);
      const d = this.noise.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      this.events = this.buildEvents();
      this.aStart = ctx.currentTime - now;
      const next = this.events.findIndex((e) => e[0] >= now);
      this.nextIdx = next < 0 ? 0 : next;
      this.loopN = next < 0 ? 1 : 0;
      this.audioOn = true;
      this.sched = window.setInterval(() => this.pump(), 40);
      this.pump();
    }

    // (re)crée les bus musique / bruitages ; débrancher les anciens coupe ce qui était déjà programmé
    newBuses() {
      const ctx = this.ctx!;
      try { this.music?.disconnect(); this.sfx?.disconnect(); } catch (e) { /* rien à couper */ }
      this.music = ctx.createGain(); this.music.gain.value = MUSIC_VOL; this.music.connect(this.comp);
      this.sfx = ctx.createGain(); this.sfx.gain.value = SFX_VOL; this.sfx.connect(this.comp);
    }

    stopAudio() {
      const t = Math.max(0, this.loopTime()) % TOTAL;
      clearInterval(this.sched);
      this.audioOn = false;
      this.t0 = performance.now() - t * 1000;
      try { this.ctx?.close(); } catch (e) { /* déjà fermé */ }
      this.ctx = null;
    }

    pump() {
      const ctx = this.ctx;
      if (!ctx || !this.events.length) return;
      const horizon = ctx.currentTime + 0.3;
      for (let guard = 0; guard < 500; guard++) {
        const ev = this.events[this.nextIdx];
        const at = this.aStart + this.loopN * TOTAL + ev[0];
        if (at > horizon) break;
        if (at >= ctx.currentTime - 0.02) this.play(ev, at);
        this.nextIdx++;
        if (this.nextIdx >= this.events.length) { this.nextIdx = 0; this.loopN++; }
      }
    }

    buildEvents(): Ev[] {
      const E: Ev[] = [];
      const b = BEAT, S = STARTS;
      // musique : groove lo-fi 100 BPM, Fmaj7 / Em7 / Dm7 / Cmaj7
      const chords = [[174.61, 220, 261.63, 329.63], [164.81, 196, 246.94, 293.66], [146.83, 174.61, 220, 261.63], [130.81, 164.81, 196, 246.94]];
      const roots = [87.31, 82.41, 73.42, 65.41];
      for (let bar = 0; bar < 16; bar++) {
        const t = bar * 4 * b, c = bar % 4;
        E.push([t, 'keys', chords[c], 1.9]);
        E.push([t + 2.5 * b, 'keys', chords[c], 0.45]);
        E.push([t, 'bass', roots[c], 0.5]);
        E.push([t + 1.5 * b, 'bass', roots[c], 0.22]);
        E.push([t + 2.5 * b, 'bass', roots[c], 0.4]);
        E.push([t + 3.5 * b, 'bass', roots[c] * 1.5, 0.2]);
        E.push([t, 'kick']); E.push([t + 2.5 * b, 'kick']);
        if (bar % 2 === 1) E.push([t + 3.5 * b, 'kick']);
        E.push([t + b, 'snare']); E.push([t + 3 * b, 'snare']);
        for (let h = 0; h < 8; h++) E.push([t + (h * b) / 2 + (h % 2 ? 0.05 : 0), 'hat', h % 2 ? 0.05 : 0.08]);
      }
      for (let k = 1; k < S.length; k++) E.push([S[k], 'crash']);
      // bruitages papier
      const type = (t: number, dur: number, n: number) => { const step = dur / n; const every = step < 0.035 ? 2 : 1; for (let i = 0; i < n; i += every) E.push([t + i * step, 'tick']); };
      const folder = (s0: number) => { E.push([s0, 'swoosh', 0.45]); E.push([s0 + 0.5, 'land']); E.push([s0 + 0.5, 'tab']); };
      const stamp = (t: number) => E.push([t + 0.3, 'thud']);
      const flick = (t: number) => E.push([t, 'flick']);
      let s: number;
      // 0 intro
      s = S[0]; E.push([s + 0.61, 'pop']); E.push([s + 0.61, 'land']); type(s + 0.8, 0.6, 9); type(s + 1.3, 0.35, 6);
      [1.45, 1.6, 1.75].forEach((x) => flick(s + x)); type(s + 2.5, 0.9, 36); E.push([s + 3.85, 'swoosh', 0.3]);
      // 1 accroche
      s = S[1]; type(s + 0.1, 0.5, 15); flick(s + 0.45); flick(s + 0.6); E.push([s + 0.4, 'pop', 0.7]); E.push([s + 2.05, 'swoosh', 0.3]);
      // 2 ads
      s = S[2]; folder(s); E.push([s + 0.35, 'pop', 0.8]); type(s + 1.6, 0.8, 26); [0.95, 1.1, 1.25].forEach((x) => flick(s + x + 0.4)); E.push([s + 1.5, 'pop', 1]); E.push([s + 1.8, 'rise', 1.5]); E.push([s + 3.2, 'pop', 1.3]); E.push([s + 5.05, 'swoosh', 0.3]);
      // 3 réseaux
      s = S[3]; folder(s); E.push([s + 0.35, 'pop', 0.85]); E.push([s + 0.7, 'pop', 1]); type(s + 1.6, 1, 40);
      [1.79, 3.02, 4.26].forEach((x) => E.push([s + x, 'swoosh', 0.22])); E.push([s + 2.2, 'pop', 1]); for (let k = 0; k < 8; k++) E.push([s + 2.45 + k * 0.18 + 0.2, 'blip', 440 + k * 60]); E.push([s + 4.1, 'pop', 1.4]); E.push([s + 5.05, 'swoosh', 0.3]);
      // 4 podcasts
      s = S[4]; folder(s); E.push([s + 0.35, 'pop', 0.9]); E.push([s + 0.8, 'pop', 1]); E.push([s + 1.1, 'pop', 1]); stamp(s + 1.6); type(s + 1.6, 0.8, 28);
      E.push([s + 1.9, 'tab']); E.push([s + 2.0, 'tab']); [0, 0.06, 0.12].forEach((x) => flick(s + 3.1 + x)); E.push([s + 5.05, 'swoosh', 0.3]);
      // 5 stratégie
      s = S[5]; folder(s); E.push([s + 0.35, 'pop', 0.95]); type(s + 1.5, 1, 40);
      for (let k = 0; k < 12; k++) E.push([s + 1.05 + k * 0.07, 'blip', 520 + k * 38]);
      [2.1, 2.2, 2.3, 2.4].forEach((x) => E.push([s + x, 'pop', 1.1])); E.push([s + 5.05, 'swoosh', 0.3]);
      // 6 événementiel
      s = S[6]; folder(s); E.push([s + 0.35, 'pop', 1]); [0.55, 0.7, 0.85, 1.0].forEach((x) => { flick(s + x); E.push([s + x + 0.45, 'land']); }); type(s + 1.3, 0.7, 28); stamp(s + 1.8); E.push([s + 3.85, 'swoosh', 0.3]);
      // 7 outro
      s = S[7]; type(s + 0.05, 0.9, 39); [0.15, 0.3, 0.45].forEach((x) => E.push([s + x + 0.48, 'land'])); E.push([s + 0.35, 'pop', 1.2]);
      [1.3, 1.66, 2.02, 2.38].forEach((x, i) => { E.push([s + x, 'blip', 660 + i * 110]); E.push([s + x, 'tab']); });
      [1.2, 1.7, 2.2].forEach((x) => E.push([s + x, 'pop', 0.6]));
      [1.3, 1.63, 1.96, 2.36, 2.7, 3.1, 3.5].forEach((x) => E.push([s + x, 'tick']));
      E.push([s + 1.2, 'rise', 0.9]); E.push([s + 2.0, 'pop', 1.5]);
      stamp(s + 2.6);
      type(s + 3.1, 0.8, 19); stamp(s + 3.75); E.push([s + 5.05, 'swoosh', 0.5]);
      E.sort((a, c) => a[0] - c[0]);
      return E;
    }

    env(g: GainNode, at: number, peak: number, a: number, dcy: number) {
      g.gain.setValueAtTime(0.0001, at);
      g.gain.exponentialRampToValueAtTime(peak, at + a);
      g.gain.exponentialRampToValueAtTime(0.0001, at + a + dcy);
    }

    nz(at: number, dur: number, filterType: BiquadFilterType, freq: number, q: number, peak: number, a: number, dcy: number, bus?: GainNode) {
      const ctx = this.ctx!;
      const src = ctx.createBufferSource(); src.buffer = this.noise;
      const f = ctx.createBiquadFilter(); f.type = filterType; f.frequency.value = freq; f.Q.value = q;
      const g = ctx.createGain(); this.env(g, at, peak, a, dcy);
      src.connect(f); f.connect(g); g.connect(bus || this.sfx);
      src.start(at, Math.random() * 1.5, dur); src.stop(at + dur + 0.05);
      return f;
    }

    osc(at: number, type: OscillatorType, f0: number, f1: number, peak: number, a: number, dcy: number, bus?: GainNode) {
      const ctx = this.ctx!;
      const o = ctx.createOscillator(); o.type = type;
      o.frequency.setValueAtTime(f0, at);
      if (f1) o.frequency.exponentialRampToValueAtTime(f1, at + a + dcy * 0.6);
      const g = ctx.createGain(); this.env(g, at, peak, a, dcy);
      o.connect(g); g.connect(bus || this.sfx);
      o.start(at); o.stop(at + a + dcy + 0.05);
    }

    play(ev: Ev, at: number) {
      const ctx = this.ctx!, k = ev[1];
      if (k === 'kick') this.osc(at, 'sine', 130, 42, 0.9, 0.004, 0.32, this.music);
      else if (k === 'snare') { this.nz(at, 0.25, 'bandpass', 1700, 0.7, 0.32, 0.003, 0.18, this.music); this.osc(at, 'triangle', 210, 150, 0.12, 0.002, 0.08, this.music); }
      else if (k === 'hat') this.nz(at, 0.06, 'highpass', 7500, 0.7, ev[2], 0.002, 0.035, this.music);
      else if (k === 'crash') this.nz(at, 1.4, 'highpass', 4000, 0.5, 0.1, 0.01, 1.2, this.music);
      else if (k === 'bass') {
        const o = ctx.createOscillator(); o.type = 'triangle'; o.frequency.value = ev[2];
        const f = ctx.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 520;
        const g = ctx.createGain(); this.env(g, at, 0.34, 0.012, ev[3]);
        o.connect(f); f.connect(g); g.connect(this.music); o.start(at); o.stop(at + ev[3] + 0.1);
      } else if (k === 'keys') {
        const f = ctx.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 1500; f.Q.value = 0.3;
        const g = ctx.createGain(); this.env(g, at, 0.075, 0.03, ev[3]);
        f.connect(g); g.connect(this.music);
        (ev[2] as number[]).forEach((fr, i) => {
          ([['sine', 0], ['triangle', 4]] as [OscillatorType, number][]).forEach(([tp, det]) => {
            const o = ctx.createOscillator(); o.type = tp; o.frequency.value = fr; o.detune.value = det + (i % 2 ? -3 : 3);
            o.connect(f); o.start(at + i * 0.012); o.stop(at + ev[3] + 0.15);
          });
        });
      } else if (k === 'swoosh') {
        const dur = ev[2];
        const f = this.nz(at, dur + 0.1, 'bandpass', 500, 1.1, 0.35, dur * 0.55, dur * 0.5);
        f.frequency.setValueAtTime(500, at); f.frequency.exponentialRampToValueAtTime(2600, at + dur);
      } else if (k === 'land') { this.nz(at, 0.12, 'lowpass', 900, 0.7, 0.3, 0.003, 0.08); this.osc(at, 'sine', 160, 70, 0.25, 0.003, 0.09); }
      else if (k === 'tab') this.nz(at, 0.06, 'bandpass', 3200, 2, 0.16, 0.002, 0.04);
      else if (k === 'flick') this.nz(at, 0.1, 'bandpass', 2400, 1.6, 0.22, 0.004, 0.07);
      else if (k === 'tick') { this.nz(at, 0.03, 'highpass', 3000, 0.8, 0.16, 0.001, 0.016); this.osc(at, 'square', 1900 + Math.random() * 300, 0, 0.025, 0.001, 0.008); }
      else if (k === 'thud') { this.osc(at, 'sine', 115, 38, 1.0, 0.003, 0.3); this.nz(at, 0.18, 'lowpass', 500, 0.7, 0.55, 0.002, 0.13); }
      else if (k === 'pop') { const m = ev[2] || 1; this.osc(at, 'sine', 380 * m, 820 * m, 0.32, 0.003, 0.09); }
      else if (k === 'blip') this.osc(at, 'sine', ev[2], 0, 0.1, 0.003, 0.08);
      else if (k === 'rise') this.osc(at, 'triangle', 330, 660, 0.06, 0.05, ev[2]);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-sr]').forEach((el) => new Showreel(el));
</script>
